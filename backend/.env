# AI Models
DETECTION_MODEL_PATH=models/yolov8n.pt
# Place a MobileNetV2 binary gender .pt checkpoint here to enable gender classification
GENDER_MODEL_PATH=models/gender_classifier.pt

# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Video Processing Config
# Minimum confidence for YOLO to accept a detection (default was 0.25 — raised to 0.4 to reduce false positives)
CONFIDENCE_THRESHOLD=0.4
# Non-Maximum Suppression overlap threshold (lower = fewer overlapping boxes)
IOU_THRESHOLD=0.5
